{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "amfie/feature-card",
	"title": "Carte",
	"category": "amfie",
	"icon": "index-card",
	"description": "Carte : icône, titre, texte, lien.",
	"textdomain": "amfie-blocks",
	"attributes": {
		"icon": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"text": {
			"type": "string",
			"default": ""
		},
		"url": {
			"type": "string",
			"default": ""
		},
		"linkLabel": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"align": false,
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "amfie-blocks-editor",
	"style": "amfie-blocks-style",
	"render": "file:./render.php",
	"parent": [
		"amfie/feature-grid"
	]
}
