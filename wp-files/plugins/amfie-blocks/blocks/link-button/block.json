{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "amfie/link-button",
	"title": "Bouton / lien",
	"category": "amfie",
	"icon": "button",
	"description": "Lien simple utilisable seul ou dans les listes de liens.",
	"textdomain": "amfie-blocks",
	"attributes": {
		"label": {
			"type": "string",
			"default": ""
		},
		"url": {
			"type": "string",
			"default": ""
		},
		"linkType": {
			"type": "string",
			"default": ""
		},
		"pageId": {
			"type": "integer",
			"default": 0
		},
		"anchor": {
			"type": "string",
			"default": ""
		},
		"style": {
			"type": "string",
			"default": "solid"
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"align": false,
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "amfie-blocks-editor",
	"style": "amfie-blocks-style",
	"render": "file:./render.php"
}
