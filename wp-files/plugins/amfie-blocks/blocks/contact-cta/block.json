{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "amfie/contact-cta",
	"title": "Appel à contact",
	"category": "amfie",
	"icon": "email-alt",
	"description": "Bandeau « Besoin d’informations ? » (idéal en motif synchronisé).",
	"textdomain": "amfie-blocks",
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"buttonLabel": {
			"type": "string",
			"default": ""
		},
		"buttonUrl": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"align": false,
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "amfie-blocks-editor",
	"style": "amfie-blocks-style",
	"render": "file:./render.php"
}
