{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "amfie/intro",
	"title": "Présentation (texte + image)",
	"category": "amfie",
	"icon": "align-pull-left",
	"description": "Titre, texte, bouton et image côte à côte.",
	"textdomain": "amfie-blocks",
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"text": {
			"type": "string",
			"default": ""
		},
		"imageUrl": {
			"type": "string",
			"default": ""
		},
		"imageId": {
			"type": "number",
			"default": 0
		},
		"buttonLabel": {
			"type": "string",
			"default": ""
		},
		"buttonUrl": {
			"type": "string",
			"default": ""
		},
		"reverse": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"align": false,
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "amfie-blocks-editor",
	"style": "amfie-blocks-style",
	"render": "file:./render.php"
}
