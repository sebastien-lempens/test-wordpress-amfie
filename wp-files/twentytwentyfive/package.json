{
	"name": "twentytwentyfive",
	"version": "1.5.0",
	"description": "Default WP Theme",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"WordPress",
		"Theme"
	],
	"bugs": {
		"url": "https://core.trac.wordpress.org/"
	},
	"homepage": "https://wordpress.org/themes/twentytwentyfive/",
	"engines": {
		"node": ">=20.10.0",
		"npm": ">=10.2.3"
	},
	"devDependencies": {
		"@tailwindcss/cli": "^4.3.3",
		"@wordpress/browserslist-config": "^6.34.0",
		"cssnano": "^7.1.2",
		"postcss": "^8.5.6",
		"postcss-cli": "^11.0.1",
		"tailwindcss": "^4.3.3"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
  "scripts": {
    "build": "npm run build:core && npm run build:tw && npm run build:tw-editor",
    "build:core": "postcss style.css --use cssnano -o style.min.css --no-map",
    "build:tw": "tailwindcss -i src/css/main.css -o dist/tailwind.css --minify",
    "build:tw-editor": "tailwindcss -i src/css/editor.css -o dist/editor.css --minify",
    "watch:tw": "npm run build:tw -- --watch",
    "watch:tw-editor": "npm run build:tw-editor -- --watch",
    "watch:tws": "node -e \"const{spawn}=require('child_process');['build:tw','build:tw-editor'].forEach(s=>spawn('npm run '+s,{stdio:'inherit',shell:true}))\"",
    "watch": "postcss style.css --use cssnano -o style.min.css --no-map --watch"
  }
}
