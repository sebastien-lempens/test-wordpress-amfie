{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "amfie/news-list",
	"title": "Liste d’actualités",
	"category": "amfie",
	"icon": "megaphone",
	"description": "Derniers articles (filtrés sur la langue courante si Polylang est actif).",
	"textdomain": "amfie-blocks",
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"count": {
			"type": "number",
			"default": 3
		},
		"buttonLabel": {
			"type": "string",
			"default": ""
		},
		"buttonUrl": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"align": false,
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "amfie-blocks-editor",
	"style": "amfie-blocks-style",
	"render": "file:./render.php"
}
